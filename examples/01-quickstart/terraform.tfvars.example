# Copy to terraform.tfvars and edit.
#
#   cp terraform.tfvars.example terraform.tfvars
#   terraform init && terraform apply

# Must be globally unique enough to claim a Foundry custom subdomain.
name_prefix      = "contoso-aigw"
environment_name = "dev"

# Check the model availability table before changing this; not every region carries every model.
location = "eastus"

publisher_name  = "Contoso AI Platform"
publisher_email = "ai-platform@contoso.com"

# A cap, not a retention policy: data beyond it is dropped rather than deferred.
log_analytics_daily_quota_gb = 5

# --- Bring your own observability -----------------------------------------------------------------
#
# Decided independently: leave one blank and it is created, supply a resource ID and it is reused.
# Most organisations already have a central workspace and expect workloads to log into it.
#
# Check two things before reusing an Application Insights component, because neither can be fixed
# from here. It must be workspace-based, and its sampling must be 100%. Sampling silently drops
# telemetry, and a dropped record is a missing chargeback row, so a sampled component understates
# spend without ever reporting an error.
#
# existing_log_analytics_workspace_id = "/subscriptions/.../resourceGroups/platform-rg/providers/Microsoft.OperationalInsights/workspaces/platform-law"
# existing_application_insights_id    = "/subscriptions/.../resourceGroups/platform-rg/providers/Microsoft.Insights/components/platform-appi"

# A Foundry project is not needed to serve inference through the gateway, so this is off by default.
# Turn it on to get the project-scoped endpoint the Foundry SDK and portal expect, and the surface
# that Agent Service and connections to Search or Storage attach to.
create_foundry_project = false

tags = {
  cost_centre = "CC-1234"
  owner       = "ai-platform@contoso.com"
}
