# Copy to terraform.tfvars and edit.

name_prefix      = "contoso-aigw"
environment_name = "prod"

primary_location   = "eastus"
secondary_location = "westeurope"

publisher_name  = "Contoso AI Platform"
publisher_email = "ai-platform@contoso.com"

# ---------------------------------------------------------------------------------------------------
# Network
#
# Every network resource below is bring-your-own, and the choice is made by leaving a field blank or
# filling it in. Blank means "create this for me". A resource ID means "use this one". Each piece is
# decided on its own, so a partial hand-over works - which is the normal case, because a platform
# team rarely owns all of it or none of it.
#
# Addresses are only used for subnets this deployment creates.
# ---------------------------------------------------------------------------------------------------
address_space                          = "10.60.0.0/16"
apim_subnet_address_prefix             = "10.60.1.0/27"
private_endpoint_subnet_address_prefix = "10.60.2.0/24"

# --- Virtual network, subnets, network security groups -------------------------------------------
#
# Leave all five blank for a self-contained deployment that creates its own network. That is the
# default and what the walkthrough assumes.
#
# Supply the virtual network alone and this deployment carves its subnets inside it - the usual
# arrangement when a platform team hands over an empty spoke.
#
# Supply the subnets as well and they are used exactly as they are. Nothing is attached to them: no
# network security group, no delegation, no NAT gateway. Those are properties of the subnet, and a
# workload deployment reaching into a platform team's resource to change them is how landing zones
# get broken. Arrive with the subnet configured, because API Management will not start without a
# network security group on it, and the v2 tiers need it delegated to Microsoft.Web/serverFarms.
# Both are checked at plan time rather than thirty minutes into an apply.
#
# existing_virtual_network_id         = "/subscriptions/.../resourceGroups/platform-rg/providers/Microsoft.Network/virtualNetworks/spoke-ai-prod"
# existing_apim_subnet_id             = "/subscriptions/.../resourceGroups/platform-rg/providers/Microsoft.Network/virtualNetworks/spoke-ai-prod/subnets/snet-apim"
# existing_private_endpoint_subnet_id = "/subscriptions/.../resourceGroups/platform-rg/providers/Microsoft.Network/virtualNetworks/spoke-ai-prod/subnets/snet-privatelink"

# Bring a corporate network security group but still let this deployment create the subnets. Only
# consulted for subnets created here; a subnet you supplied keeps whatever it already has.
#
# existing_apim_nsg_id             = "/subscriptions/.../providers/Microsoft.Network/networkSecurityGroups/corp-apim-nsg"
# existing_private_endpoint_nsg_id = "/subscriptions/.../providers/Microsoft.Network/networkSecurityGroups/corp-privatelink-nsg"

# --- Bring your own observability -----------------------------------------------------------------
#
# Decided independently, same as the network above: leave one blank and it is created, supply a
# resource ID and it is reused. In a landing zone the workspace is almost always a platform-team
# resource, so reuse is the normal answer here.
#
# Check two things before reusing an Application Insights component, because neither can be fixed
# from here. It must be workspace-based, and its sampling must be 100%. Sampling silently drops
# telemetry, and a dropped record is a missing chargeback row, so a sampled component understates
# spend without ever reporting an error.
#
# existing_log_analytics_workspace_id = "/subscriptions/.../resourceGroups/platform-rg/providers/Microsoft.OperationalInsights/workspaces/platform-law"
# existing_application_insights_id    = "/subscriptions/.../resourceGroups/platform-rg/providers/Microsoft.Insights/components/platform-appi"

# --- Private DNS ----------------------------------------------------------------------------------
#
# Decided per zone. Name the zones that already exist and the rest are created, so a hand-over of one
# or two zones works without an all-or-nothing switch. In a hub-and-spoke estate these are almost
# always central: creating a duplicate zone inside a spoke breaks name resolution across the whole
# landing zone, and does so intermittently, which is worse. If you are not sure whether your platform
# team owns them, assume they do and ask.
#
# existing_private_dns_zone_ids = {
#   "privatelink.cognitiveservices.azure.com" = "/subscriptions/.../privateDnsZones/privatelink.cognitiveservices.azure.com"
#   "privatelink.openai.azure.com"            = "/subscriptions/.../privateDnsZones/privatelink.openai.azure.com"
#   "privatelink.services.ai.azure.com"       = "/subscriptions/.../privateDnsZones/privatelink.services.ai.azure.com"
# }

# A zone that is not linked to the virtual network resolves nothing from inside it. Zones created
# here are linked automatically; supplied ones are left alone, because they are normally linked
# already and a workload identity normally cannot write to them. Turn this on if you own the zones
# but keep them in a different resource group.
# link_existing_private_dns_zones = true

# Set both of these only when name resolution genuinely lives somewhere this deployment cannot see -
# a central resolver, or conditional forwarding from on-premises. Without a zone, clients inside the
# network resolve the model endpoint to its public address and the private endpoints are never used:
# the deployment looks healthy, the traffic is not private, and nothing reports an error.
# create_private_dns_zones     = false
# require_private_dns_coverage = false

# Turn this on when a downstream endpoint allow-lists source addresses, or at volumes where SNAT port
# exhaustion becomes a real failure mode.
enable_nat_gateway = false

# ---------------------------------------------------------------------------------------------------
# Capacity, in thousands of tokens per minute for Standard SKUs
# ---------------------------------------------------------------------------------------------------
chat_capacity      = 100
chat_mini_capacity = 200
embedding_capacity = 100

# ---------------------------------------------------------------------------------------------------
# Consumers
#
# Name subscriptions after applications, never after people. The subscription name is the chargeback
# identity, and people change teams far more often than applications change owners.
# ---------------------------------------------------------------------------------------------------
subscriptions = {
  "customer-support-copilot" = {
    product_key = "internal-apps"
    cost_centre = "CC-1001"
    owner       = "support-eng@contoso.com"
  }
  "contract-analysis" = {
    product_key = "internal-apps"
    cost_centre = "CC-1002"
    owner       = "legal-tech@contoso.com"
  }
  "sales-research-agent" = {
    product_key = "agents"
    cost_centre = "CC-2001"
    owner       = "revops@contoso.com"
  }
  "model-eval-harness" = {
    product_key = "evaluation"
    cost_centre = "CC-9000"
    owner       = "ai-platform@contoso.com"
  }
}

consumers = {
  "customer-support-copilot" = {
    cost_centre        = "CC-1001"
    owner              = "support-eng@contoso.com"
    business_unit      = "Customer Operations"
    monthly_budget_usd = 3000
    alert_email        = "support-eng@contoso.com"
  }
  "contract-analysis" = {
    cost_centre        = "CC-1002"
    owner              = "legal-tech@contoso.com"
    business_unit      = "Legal"
    monthly_budget_usd = 1200
  }
  "sales-research-agent" = {
    cost_centre        = "CC-2001"
    owner              = "revops@contoso.com"
    business_unit      = "Revenue Operations"
    monthly_budget_usd = 800
  }
  "model-eval-harness" = {
    cost_centre        = "CC-9000"
    owner              = "ai-platform@contoso.com"
    business_unit      = "AI Platform"
    monthly_budget_usd = 400
  }
}

# ---------------------------------------------------------------------------------------------------
# Pricing
#
# Do not hand-maintain this. Regenerate it on a schedule:
#
#   python scripts/generate_pricing_map.py \
#     --region eastus \
#     --alias chat=gpt-4.1 \
#     --alias chat-fast=gpt-4.1-mini \
#     --alias embed=text-embedding-3-large \
#     --output pricing.auto.tfvars.json
#
# Rates are per `unit` tokens, matching how Azure publishes them.
# ---------------------------------------------------------------------------------------------------
pricing_map = {
  "chat" = {
    unit          = 1000000
    input         = 2.50
    cachedInput   = 1.25
    output        = 10.00
    effectiveDate = "2026-01-01"
  }
  "chat-fast" = {
    unit          = 1000000
    input         = 0.15
    cachedInput   = 0.075
    output        = 0.60
    effectiveDate = "2026-01-01"
  }
  "embed" = {
    unit          = 1000000
    input         = 0.13
    output        = 0.0
    effectiveDate = "2026-01-01"
  }
}

# ---------------------------------------------------------------------------------------------------
# Guardrails
# ---------------------------------------------------------------------------------------------------
monthly_budget_usd        = 5000
daily_spend_threshold_usd = 250

# The fast signal. Log alerts run hourly; an agent loop does not wait an hour.
token_rate_alert_threshold = 2000000

alert_emails = ["ai-platform@contoso.com", "finops@contoso.com"]

# Turn on when chargeback numbers have to survive being disputed.
enable_eventhub_audit = false

content_safety_threshold = 4

log_retention_days           = 90
log_analytics_daily_quota_gb = 50

tags = {
  cost_centre = "CC-9000"
  owner       = "ai-platform@contoso.com"
  compliance  = "internal"
}

# ---------------------------------------------------------------------------------------------------
# Caller authentication (Microsoft Entra ID)
#
# Leave caller_tenant_id commented out to run on subscription keys alone, which is the right starting
# point for a proof of concept. Uncomment it for production.
#
# Why bother, when the key already works: a subscription key is a bearer secret. It gets copied into a
# second service, shared between two teams, or pasted into a notebook, and from that moment the
# chargeback report attributes that spend to the wrong consumer with nothing to indicate it. An Entra
# token is issued to a specific app registration or managed identity, cannot be meaningfully copied,
# and expires on its own.
#
# Setup, once:
#   1. Register an application to represent the gateway itself and set its Application ID URI:
#        az ad app create --display-name "Contoso AI Gateway" --query appId -o tsv
#        az ad app update --id <app-id> --identifier-uris api://contoso-ai-gateway
#      That URI is the audience below.
#   2. For each calling workload, use its existing managed identity or app registration. Its client id
#      goes in caller_client_application_ids and keys caller_consumer_names.
#   3. Callers request a token for the audience and send it as "Authorization: Bearer <token>",
#      alongside the api-key header they already send:
#        az account get-access-token --resource api://contoso-ai-gateway --query accessToken -o tsv
#
# Both the audience and the client id are checked. The audience proves the token was minted for this
# gateway rather than for Microsoft Graph or some other API in the same tenant; the client id proves
# which application asked for it. Checking only the tenant would accept any token the tenant ever
# issued, which is not authentication so much as the appearance of it.
# ---------------------------------------------------------------------------------------------------
# caller_tenant_id = "00000000-0000-0000-0000-000000000000"
# caller_audiences = ["api://contoso-ai-gateway"]
# caller_client_application_ids = [
#   "11111111-1111-1111-1111-111111111111", # claims-assistant
#   "22222222-2222-2222-2222-222222222222", # support-copilot
# ]
#
# Friendly names so cost reports read as service names rather than GUIDs. Purely cosmetic.
# caller_consumer_names = {
#   "11111111-1111-1111-1111-111111111111" = "claims-assistant"
#   "22222222-2222-2222-2222-222222222222" = "support-copilot"
# }
